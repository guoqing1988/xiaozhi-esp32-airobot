{
    "type": "bread-compact-wifi-s3cam-airobot",
    "target": "esp32s3",
    "builds": [
        {
            "name": "bread-compact-wifi-s3cam-airobot",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y"
            ]
        },
        {
            "name": "bread-compact-wifi-s3cam-airobot-no-tfcard",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_LCD_ST7789_240X320=y",
                "CONFIG_FATFS_API_ENCODING_UTF_8=y",
                "CONFIG_XIAOZHI_AIROBOT_ENABLE_TF_CARD=n",
                "CONFIG_USE_EMOTE_MESSAGE_STYLE=y"
            ]
        }
    ]
}
